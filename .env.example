# Copier ce fichier en .env puis remplir les valeurs
# (Supabase : Project Settings → API Keys).
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# Clé publishable (sb_publishable_…) : utilisée par le serveur pour la connexion
# des utilisateurs. La RLS limite chaque compte à ses propres publications.
SUPABASE_PUBLISHABLE_KEY=""
# Adresse publique du site, utilisée dans l'email de confirmation
# (facultatif en local : http://localhost:3000 par défaut).
SITE_URL="http://localhost:3000"
PORT="3000"
